{
  "name": "twinstone-tdi",
  "version": "2.0.0",
  "description": "Turbocharged Direct Infusion",
  "homepage": "https://github.com/twinstone/tdi",
  "type": "module",
  "sideEffects": [
    "./dist/auto.js",
    "./dist/tdi.global.js"
  ],
  "main": "./dist/tdi.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/tdi.js"
    },
    "./auto": {
      "types": "./dist/auto.d.ts",
      "import": "./dist/auto.js"
    },
    "./global": "./dist/tdi.global.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run",
    "build": "vite build && tsc -p tsconfig.build.json",
    "size": "size-limit",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/twinstone/tdi.git"
  },
  "author": "Ivan Čentéš, Etnetera a.s.",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/twinstone/tdi/issues"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "size-limit": "^14.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
