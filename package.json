{
  "name": "tdi",
  "version": "2.0.11-beta",
  "homepage": "https://github.com/twinstone/tdi",
  "author": "Ivan Čentéš & Pavel Hasala, Etnetera a.s.",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/twinstone/tdi/issues"
  },
  "main": "dist/tdi.js",
  "typings": "dist/tdi.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=10"
  },
  "scripts": {
    "start": "tsdx watch --format cjs,esm,umd",
    "build": "tsdx build --format cjs,esm,umd",
    "test:watch": "tsdx test --watch",
    "test": "tsdx test",
    "lint": "tsdx lint --fix",
    "prepare": "tsdx build --format cjs,esm,umd",
    "size": "size-limit",
    "analyze": "size-limit --why"
  },
  "peerDependencies": {},
  "husky": {
    "hooks": {
      "pre-commit": "tsdx lint"
    }
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "module": "dist/tdi2.esm.js",
  "size-limit": [
    {
      "path": "dist/tdi2.cjs.production.min.js",
      "limit": "10 KB"
    },
    {
      "path": "dist/tdi2.esm.js",
      "limit": "10 KB"
    }
  ],
  "devDependencies": {
    "@size-limit/preset-small-lib": "^11.2.0",
    "husky": "^9.1.7",
    "size-limit": "^11.2.0",
    "tsdx": "^0.14.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.2"
  },
  "pre-commit": [
    "lint",
    "test"
  ]
}
